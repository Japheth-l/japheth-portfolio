<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content.heroName %> | <%= content.heroRole %></title>
  <%- include('partials/head') %>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>
<%- include('partials/nav') %>

<main id="main">

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__hello"><%= content.heroHello %></p>
        <h1 class="hero__name"><%= content.heroName %></h1>
        <p class="hero__role"><%= content.heroRole %></p>
        <p class="hero__lede"><%= content.heroLede %></p>

        <div class="hero__actions">
          <a href="#projects" class="btn btn--primary">View my work</a>
          <a href="#contact" class="btn btn--ghost">Get in touch</a>
        </div>

        <div class="hero__socials">
          <a href="https://github.com/Japheth-l" target="_blank" rel="noopener" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/japheth-lamuo" target="_blank" rel="noopener" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=lamuojapheth@gmail.com&amp;su=Opportunity%20for%20Japheth&amp;body=Hi%20Japheth%2C%0A%0A" target="_blank" rel="noopener" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            lamuojapheth@gmail.com
          </a>
        </div>
      </div>

      <div class="hero__photo-wrap">
        <div class="hero__photo-glow"></div>
        <img src="/images/profile-photo.jpg" alt="<%= content.heroName %>" class="hero__photo" width="300" height="300" />
      </div>
    </div>
  </section>

  <!-- TERMINAL -->
  <div class="terminal-section">
    <div class="terminal-section__inner">
      <div class="terminal" role="img" aria-label="Terminal showing a curl request to this site's own API returning a developer profile as JSON">
        <div class="terminal__bar">
          <span class="dot dot--red"></span><span class="dot dot--amber"></span><span class="dot dot--green"></span>
          <span class="terminal__title">request.sh</span>
        </div>
        <pre class="terminal__body"><code id="terminalText"></code></pre>
      </div>
      <div class="terminal-section__copy">
        <p class="eyebrow">How I think</p>
        <h2>The backend perspective</h2>
        <p>I think in endpoints, payloads, and status codes, so I built this portfolio as an API. That <code>/api/me</code> call is real. The page you are reading is rendered by the same Express server, from the same MongoDB.</p>
        <div class="terminal-section__links">
          <a href="/api/me" target="_blank" rel="noopener">Try /api/me ↗</a>
          <a href="/api/projects" target="_blank" rel="noopener">Try /api/projects ↗</a>
        </div>
      </div>
    </div>
  </div>

  <!-- PROJECTS -->
  <section class="endpoints" id="projects">
    <div class="section__head">
      <p class="eyebrow">Projects</p>
      <h2>Routes I've shipped</h2>
      <p class="section__sub">Served live from MongoDB. <%= projects.length %> record<%= projects.length === 1 ? '' : 's' %> returned.</p>
    </div>

    <div class="endpoint-list">
      <% if (!projects.length) { %>
        <article class="endpoint endpoint--empty">
          <div class="endpoint__head">
            <span class="method method--get">GET</span>
            <span class="route">/projects</span>
            <span class="status">204 No Content</span>
          </div>
          <p>No projects published here yet. The fastest way to see my work is <a href="https://github.com/Japheth-l" target="_blank" rel="noopener">GitHub</a>.</p>
        </article>
      <% } %>
      <% projects.forEach(project => { %>
        <article class="endpoint">
          <div class="endpoint__head">
            <span class="method method--<%= project.method.toLowerCase() %>"><%= project.method %></span>
            <span class="route"><%= project.route %></span>
            <span class="status"><%= project.status %></span>
          </div>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <% if (project.tags && project.tags.length) { %>
            <ul class="tags">
              <% project.tags.forEach(tag => { %><li><%= tag %></li><% }) %>
            </ul>
          <% } %>
          <div class="endpoint__links">
            <% if (project.liveUrl) { %>
              <a href="<%= project.liveUrl %>" target="_blank" rel="noopener" data-track="project_click" data-label="<%= project.title %> (live)">Live API ↗</a>
            <% } %>
            <% if (project.sourceUrl) { %>
              <a href="<%= project.sourceUrl %>" target="_blank" rel="noopener" data-track="project_click" data-label="<%= project.title %> (source)">Source ↗</a>
            <% } %>
            <% if (!project.liveUrl && !project.sourceUrl) { %>
              <a href="#contact">Ask for repo access ↗</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="stack" id="stack">
    <div class="section__head">
      <p class="eyebrow">Skills</p>
      <h2>dependencies</h2>
      <p class="section__sub">The tools I reach for, as they'd look in a manifest.</p>
    </div>
    <pre class="pkg"><code>{
<% const skillEntries = Object.entries(content.skills || {}); skillEntries.forEach(([key, values], i) => { %>  <span class="pkg__key">"<%= key %>"</span>: [<% values.forEach((v, j) => { %><span class="pkg__val">"<%= v %>"</span><%= j < values.length - 1 ? ', ' : '' %><% }) %>]<%= i < skillEntries.length - 1 ? ',' : '' %>
<% }) %>}</code></pre>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <div class="section__head">
      <p class="eyebrow">About</p>
      <h2>How I got here</h2>
    </div>
    <div class="about__body">
      <% (content.aboutParagraphs || []).forEach(p => { %><p><%= p %></p><% }) %>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="contact__inner">
      <p class="eyebrow">Contact</p>
      <h2>Let's build something that stays up.</h2>
      <p class="section__sub">Open to junior backend roles and freelance projects. This form POSTs to <code>/api/contact</code> on this server, where it is validated, rate-limited, stored, and emailed to me.</p>

      <form class="contact__form" id="contactForm" novalidate>
        <div class="contact__field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="contact__field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" placeholder="your@email.com" autocomplete="email" required />
        </div>
        <div class="contact__field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" placeholder="What are you building?" required></textarea>
        </div>
        <button type="submit" id="cf-submit" class="btn btn--primary">Send message</button>
        <p id="cf-status" class="cf-status" aria-live="polite"></p>
      </form>

      <div class="contact__links">
        <a href="https://github.com/Japheth-l" target="_blank" rel="noopener" class="btn btn--ghost">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/japheth-lamuo" target="_blank" rel="noopener" class="btn btn--ghost">LinkedIn ↗</a>
        <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=lamuojapheth@gmail.com&amp;su=Opportunity%20for%20Japheth&amp;body=Hi%20Japheth%2C%0A%0A" target="_blank" rel="noopener" class="btn btn--ghost">Email ↗</a>
        <button type="button" class="btn btn--ghost" data-copy-email="lamuojapheth@gmail.com">Copy email</button>
        <a href="/Japheth_Lamuo_Resume.pdf" target="_blank" rel="noopener" class="btn btn--ghost" data-track="resume_download">Resume ↗</a>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=<%= assetVersion %>"></script>
</body>
</html>
