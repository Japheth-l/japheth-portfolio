# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB — set this in production (Atlas connection string).
# If left unset in development, the app spins up an in-memory MongoDB automatically.
MONGODB_URI=

# Email (contact form) — https://resend.com
RESEND_API_KEY=
OWNER_EMAIL=lamuojapheth@gmail.com

# Admin auth
ADMIN_EMAIL=lamuojapheth@gmail.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-this-to-a-long-random-string
